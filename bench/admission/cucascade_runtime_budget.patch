+{
+  if (_memory_limit == 0 || new_limit == 0) { return; }
+  double const scale = static_cast<double>(new_limit) / static_cast<double>(_memory_limit);
+  _start_downgrading_memory_threshold =
+    static_cast<size_t>(static_cast<double>(_start_downgrading_memory_threshold) * scale);
+  _stop_downgrading_memory_threshold =
+    static_cast<size_t>(static_cast<double>(_stop_downgrading_memory_threshold) * scale);
+  _capacity     = static_cast<size_t>(static_cast<double>(_capacity) * scale);
+  _memory_limit = new_limit;
